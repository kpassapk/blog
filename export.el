;;; export.el --- Export org/ posts into the Hugo blog -*- lexical-binding: t; -*-

;;; Commentary:
;;
;; Blog posts are authored as plain org files in `org/' at the repo root and
;; published with ox-hugo into `content/posts/'.  Rather than sprinkle ox-hugo
;; keywords through every post, this file injects the derived keywords into a
;; scratch copy at export time.  The sources on disk are never touched.
;;
;; Each source carries its own #+TITLE, #+DATE, #+HUGO_TAGS and so on; the
;; exporter adds only the plumbing: the Hugo base directory, the "posts"
;; section, the output file name (the org file's basename), and a
;; `source: org/<file>.org' front-matter marker.
;;
;; That marker is what makes re-exports safe while the old hand-written
;; Markdown posts are still being migrated: the clean step deletes only .md
;; files whose front matter carries the marker.  Unmarked hand-written posts,
;; `_index.md', and page bundles with images are never touched.
;;
;; `org-export-use-babel' is bound to nil, so exporting never evaluates a
;; source block.
;;
;; Usage:
;;
;;   make export            ;; via emacsclient, uses your running Emacs
;;   make export-batch      ;; no Emacs server needed
;;   M-x blog-export-all    ;; from a running Emacs

;;; Code:

(unless (require 'ox-hugo nil :noerror)
  ;; A batch Emacs does not load the user's init, so pick up ox-hugo from
  ;; their installed packages.
  (require 'package)
  (package-initialize)
  (require 'ox-hugo))

(require 'subr-x)

(defconst blog-root
  (file-name-as-directory
   (directory-file-name
    (file-name-directory (or load-file-name buffer-file-name default-directory))))
  "Absolute path of the repo root (the directory holding hugo.toml).")

(defconst blog-org-dir (expand-file-name "org" blog-root)
  "Directory holding the org sources.")

(defconst blog-section "posts"
  "Hugo section every post is exported into.")

(defconst blog-source-marker-re
  "^source: [\"']?org/.+\\.org[\"']?[ \t]*$"
  "Front-matter line marking a Markdown file as generated by this exporter.")


;;;; Export

(defun blog--keyword-block (file)
  "Return the ox-hugo keywords injected ahead of FILE's contents."
  (concat
   (format "#+HUGO_BASE_DIR: %s\n" (directory-file-name blog-root))
   (format "#+HUGO_SECTION: %s\n" blog-section)
   (format "#+EXPORT_FILE_NAME: %s\n" (file-name-base file))
   (format "#+HUGO_CUSTOM_FRONT_MATTER: :source %s\n"
           (file-relative-name file blog-root))))

(defun blog--export-buffer ()
  "Run ox-hugo on the current buffer with export-safe settings."
  (let ((org-export-use-babel nil)          ;never run babel on export
        (org-export-with-broken-links t)
        (org-export-with-toc nil)
        ;; The author would be whoever ran the export, not who wrote it.
        (org-export-with-author nil)
        (org-export-with-email nil)
        (org-hugo-front-matter-format "yaml")
        (org-hugo-export-creator-string nil)
        (org-hugo-suppress-lastmod-period 0.0))
    (org-hugo-export-to-md)))

;;;###autoload
(defun blog-export-file (file)
  "Export org FILE into content/posts.  Return the output file name."
  (interactive (list (read-file-name "Org file: " blog-org-dir nil t)))
  (let* ((file (expand-file-name file))
         (keywords (blog--keyword-block file)))
    ;; ox-hugo refuses to run without it when a post references an image
    ;; outside its page bundle (the copy lands in static/ox-hugo/).
    (make-directory (expand-file-name "static" blog-root) t)
    (with-temp-buffer
      (setq default-directory (file-name-directory file))
      (insert keywords)
      (insert-file-contents file)
      (goto-char (point-max))
      (let ((org-inhibit-startup t))
        (org-mode))
      ;; Point the scratch buffer at the real file for the duration of the
      ;; export (relative links resolve against it), then disown it so
      ;; `with-temp-buffer' can kill it without prompting.
      (unwind-protect
          (progn
            (setq buffer-file-name file)
            (blog--export-buffer))
        (setq buffer-file-name nil)
        (set-buffer-modified-p nil)))))


;;;; Cleaning

(defun blog--generated-p (md-file)
  "Non-nil when MD-FILE's front matter carries the `source: org/...' marker."
  (with-temp-buffer
    (insert-file-contents md-file nil 0 4096)
    (goto-char (point-min))
    (when (looking-at "---[ \t]*$")
      (let ((end (save-excursion
                   (forward-line 1)
                   (when (re-search-forward "^---[ \t]*$" nil t)
                     (point)))))
        (when end
          (re-search-forward blog-source-marker-re end t))))))

(defun blog--clean-generated ()
  "Delete previously exported posts, leaving everything else alone.
Only regular .md files in content/posts whose front matter carries the
`source:' marker are removed; hand-written posts, `_index.md', and page
bundle directories are never touched."
  (let ((dir (expand-file-name (concat "content/" blog-section) blog-root)))
    (when (file-directory-p dir)
      (dolist (f (directory-files dir :full "\\.md\\'"))
        (when (and (file-regular-p f)
                   (not (equal (file-name-nondirectory f) "_index.md"))
                   (blog--generated-p f))
          (message "blog: removing %s" (file-relative-name f blog-root))
          (delete-file f))))))


;;;; Entry point

(defun blog--org-files ()
  "Return the absolute paths of the org sources, skipping lock/backup files."
  (when (file-directory-p blog-org-dir)
    (seq-remove (lambda (f)
                  (string-match-p "\\`[.#]" (file-name-nondirectory f)))
                (directory-files blog-org-dir :full "\\.org\\'"))))

;;;###autoload
(defun blog-export-all ()
  "Export every org/*.org into content/posts, replacing earlier exports."
  (interactive)
  (blog--clean-generated)
  (let ((count 0))
    (dolist (file (blog--org-files))
      (when (file-readable-p file)
        (message "blog: %s -> %s" (file-relative-name file blog-root) blog-section)
        (blog-export-file file)
        (setq count (1+ count))))
    (message "blog: exported %d post%s" count (if (= count 1) "" "s"))
    count))

(provide 'blog-export)
;;; export.el ends here
